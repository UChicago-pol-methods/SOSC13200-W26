%%% [[TEMPLATEs]] %%%
%-------------------------------------------------------------------------------%
\begin{frame}[fragile]{Frametitle}

\begin{center}
<<fig.width = 5, fig.height =5, echo=FALSE, out.width='0.7\\textwidth'>>=
hist(rnorm(10))
@
\end{center}

\end{frame}


%%%%%NOTE%%%%%

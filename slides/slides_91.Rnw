%-------------------------------------------------------------------------------%

\begin{frame}[fragile]{P-values}


Suppose $\hat{\theta}$ is the general form for an estimate produced by our estimator, and $\hat{\theta}^*$ is the value we have actually observed. 

\end{frame}

%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}[fragile]{P-values}

\begin{itemize}
\item A two-tailed p-value under the null hypothesis is 
$$
p = \textrm{P}_0[|\hat{\theta}| \ge |\hat{\theta}^*|]
$$
\end{itemize}

i.e., the probability \textit{under the null distribution} that we would see an estimate of $\hat{\theta}$ as or more extreme as what we saw from the data. 


\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}
%-------------------------------------------------------------------------------%
\begin{frame}%{Frametitle}

\begin{itemize}
\item Suppose we have some data, $(Y, X_1, X_2, \dots X_K)$.\pause
\item Suppose the null distribution represents the truth. \pause
\item If we test one hypothesis, what is the probability that we will find something that is statistically significant at $p \le 0.05$?\pause
\item If we test two unrelated hypotheses, what is the probability that we will find something that is statistically significant at $p \le 0.05$?
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}%{Frametitle}

\begin{itemize}
\item A: event we reject hypothesis 1 at $p \le 0.05$\pause
\item B: event we reject hypothesis 2 at $p \le 0.05$\pause
\item $\text{A} \independent \text{B}$: the two events are independent\pause
\item $\textrm{P}[\text{A}] = 0.05$\pause
\item $\textrm{P}[\text{B}] = 0.05$\pause
\item $\textrm{P}[\text{A}\cup\text{B}]$? The probability we see event A OR B?
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}%{Frametitle}
\begin{align*}
\uncover<+->{\textrm{P}[\text{A}\cup\text{B}] & = \textrm{P}[\text{A}] + \textrm{P}[\text{A}^\text{C}]\times\textrm{P}[\text{B}| \text{A}^\text{C}]}
\uncover<+->{\intertext{A and B are independent, so $\textrm{P}[\text{B}| \text{A}^\text{C}] = \textrm{P}[\text{B}]$}}\\
\uncover<+->{\textrm{P}[\text{A}\cup\text{B}] & = \textrm{P}[\text{A}] + \textrm{P}[\text{A}^\text{C}]\times\textrm{P}[\text{B}]}\\
\uncover<+->{\textrm{P}[\text{A}\cup\text{B}] & = 0.05 + 0.95 \times 0.05}\\
\uncover<+->{\textrm{P}[\text{A}\cup\text{B}] & = 0.0975}
\end{align*}

% Definition of circles
\def\firstcircle{(0,0) circle (1.5cm)}
\def\secondcircle{(0:2cm) circle (1.5cm)}

\colorlet{circle edge}{blue!50}
\colorlet{circle area}{blue!20}

\tikzset{filled/.style={fill=circle area, draw=circle edge, thick},
outline/.style={draw=circle edge, thick}}

\setlength{\parskip}{5mm}
% Set A or B
\onslide<1->{
\begin{figure}
\centering
\begin{tikzpicture}
\draw[filled] \firstcircle node {A}
\secondcircle node {B};
\node[anchor=south] at (current bounding box.north) {A$\cup$B};
\end{tikzpicture}
\end{figure}
}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}%{Frametitle}

If the null is true \dots
\begin{itemize}
\item and we conduct three independent tests, the probability that \textit{at least one of them} will be statistically significant at $p \le 0.05$ is $1-0.95^3 = 0.1426$ \pause
\item and we conduct four independent tests, the probability that \textit{at least one of them} will be statistically significant at $p \le 0.05$ is $1-0.95^4 = 0.1855$ \pause
\item and we conduct ten independent tests, the probability that \textit{at least one of them} will be statistically significant at $p \le 0.05$ is $1-0.95^{10} = 0.4013$ \pause
\end{itemize}

This becomes a real problem when researchers run many tests in their papers!

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}%{Frametitle}

\begin{table}[]
\centering
\small
\begin{tabular}{lcc}
& \begin{tabular}[c]{@{}c@{}}\textbf{Fail to reject null hypothesis}\\ (p \textgreater 0.05)\end{tabular} & \begin{tabular}[c]{@{}c@{}}\textbf{Reject null hypothesis}\\ (p $\le$ 0.05)\end{tabular}  \\
\hline
\textbf{Null hypothesis true} & True negative & Type I error, false positive  \\
\textbf{Null hypothesis false} & Type II error, false negative & True positive
\end{tabular}
\end{table}

\begin{itemize}
\item \textbf{Type I error:} (false positive) we see an effect, where one doesn't really exist \pause
\item \textbf{Type II error:} (false negative) we didn't see an effect, but one really does exist
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{Multiple testing scenarios}

\begin{itemize}
\item Comparisons across multiple treatments; A to B, B to C, A to C\dots\pause 
\item Multiple outcomes \pause
\item Heterogeneous treatment effects (where is the cut point)\pause
\item Multiple regression specifications (specification search)\pause
\end{itemize}

These tests aren't all fully independent, but the more tests we do, the more likely we are to uncover a false positive. 

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{Ways to account for multiple testing}

\begin{itemize}
\item Pre-specification of analyses \pause
\item Separating data in training and testing sets (more on this with machine learning)\pause
\item \textit{p-value adjustment}
\end{itemize}


\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{p-value adjustment}

\begin{table}[]
\centering
\small
\begin{tabular}{lcc}
& \begin{tabular}[c]{@{}c@{}}\textbf{Fail to reject null hypothesis}\\ (p \textgreater 0.05)\end{tabular} & \begin{tabular}[c]{@{}c@{}}\textbf{Reject null hypothesis}\\ (p $\le$ 0.05)\end{tabular}  \\
\hline
\textbf{Null hypothesis true} & True negative & Type I error, false positive  \\
\textbf{Null hypothesis false} & Type II error, false negative & True positive
\end{tabular}
\end{table}

\begin{itemize}
\item Family-Wise Error Rate (FWER): the probability of falsely rejecting even one \textit{true} null hypothesis; \pause $\textrm{P}[\text{Type I error} > 0]$\pause
\item False Discovery Rate (FDR): expected proportion of false discoveries among all discoveries; \pause $\E[\text{\# False discoveries}/ \text{\# All discoveries}]$ 
\end{itemize}





\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{p-value adjustment}

\begin{itemize}
\item Correcting FWER
\begin{itemize}
\item Bonferroni correction: for $m$ hypotheses, for significance level $\alpha$, implement $\alpha/m$\pause
\item four independent tests, the probability that \textit{at least one of them} will be statistically significant at $p \le \alpha$ is $1-(1-\alpha)^4 $
\item For $\alpha = 0.05$, $1-0.95^4 = 0.1855$\pause
\item With Bonferroni correction: $1-(1-\alpha/4)^4 = 0.0491$\pause
\item Ten independent tests: $1-(1-\alpha/10)^{10} = 0.0489$
\end{itemize}
\end{itemize}





\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{p-value adjustment}

What if tests are not independent? \pause Bonferroni is too aggressive. 

\begin{align*}
\onslide<2->{\textrm{P}[\text{A}\text{B}] & = \textrm{P}[\text{A}] + \textrm{P}[\text{A}^\text{C}]\times\textrm{P}[\text{B}| \text{A}^\text{C}]}
\onslide<3->{\intertext{If A and B are positively correlated $\textrm{P}[\text{B}| \text{A}^\text{C}] \le \textrm{P}[\text{B}]$}}\pause
\end{align*}

\begin{itemize}
\item<4-> Correcting FWER
\begin{itemize}
\item<5-> Holm correction: for $m$ hypotheses, for significance level $\alpha$:
\begin{itemize}
\item<6-> Order the $m$ conventionally calculated p-values from smallest to largest 
\item<7-> Find the \textit{smallest} p-value indexed as $k$ such that $p_k > \frac{\alpha}{m +1 -k}$
\item<8-> Reject all p-values greater than or equal to $p_k$, accept all p-values less $p_k$
\end{itemize}
\end{itemize}
\end{itemize}





\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{p-value adjustment}


\begin{itemize}
\item Correcting FDR\pause
\begin{itemize}
\item Benjamini-Hochberg correction: for $m$ hypotheses, for significance level $\alpha$:\pause
\begin{itemize}
\item Order the $m$ conventionally calculated p-values from smallest to largest \pause
\item Find the \textit{largest} p-value indexed as $k$ such that $p_k \le \frac{k}{m}\alpha$\pause
\item Reject all p-values greater than $p_k$, accept all p-values less than or equal to $p_k$
\end{itemize}
\end{itemize}
\end{itemize}





\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{p-value adjustment}


\begin{itemize}
\item In either case, for more complex settings, try simulation. 
\end{itemize}





\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{Multiple testing}


\begin{itemize}
\item When can you consider tests as unrelated?\pause
\item Exploratory vs. confirmatory hypotheses?
\end{itemize}





\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{What is a pre-analysis plan (PAP)?}
\cite{chen2021preanalysis}

\begin{itemize}
\item A PAP is a dated (often registered) document that specifies your design and analysis plan \textit{before} analyzing outcomes.
\item The goal is not ``no exploration'' --- it is to make clear what was \textbf{confirmatory} vs.\ \textbf{exploratory}.
\item A good PAP reduces researcher degrees of freedom:
\begin{itemize}
\item outcomes and estimands are pre-specified
\item model/specification choices are pre-specified
\item inference rules are pre-specified (e.g., two-sided $\alpha=0.05$, multiple-testing plan)
\end{itemize}
\end{itemize}

\end{frame}

%-------------------------------------------------------------------------------%
\begin{frame}{Why write a PAP?}
\cite{chen2021preanalysis} \cite{monogan2015preregistration}

\begin{itemize}
\item \textbf{Credibility:} reduces specification search and makes p-values/CI easier to interpret.
\item \textbf{Transparency:} distinguishes confirmatory vs.\ exploratory work (both can be valuable).
\item \textbf{Design discipline:} forces you to commit to outcomes, estimands, and decision rules before seeing results.
\item \textbf{Scientific record:} helps counter publication bias by making ``attempted'' studies easier to find.
\end{itemize}

\end{frame}

%-------------------------------------------------------------------------------%
\begin{frame}{Confirmatory vs.\ exploratory}
\cite{monogan2015preregistration}

\begin{itemize}
\item \textbf{Confirmatory:} the primary contrast(s), outcomes, and analysis choices were committed to in advance.
\item \textbf{Exploratory:} additional outcomes, subgroup cuts, specifications, or hypotheses investigated after seeing data.
\item Exploratory analyses are valuable --- but they should be labeled as such and interpreted cautiously.
\end{itemize}

\end{frame}

%-------------------------------------------------------------------------------%
\begin{frame}{What goes in a PAP? (EGAP checklist)}
\cite{chen2021preanalysis}

\begin{enumerate}
\item Study design overview (unit, population, assignment, arms, outcomes)
\item Hypotheses (confirmatory vs exploratory; one- vs two-sided if relevant)
\item Measurement / index construction / transformations
\item Estimand(s) and estimator(s) (e.g., diff-in-means; regression adjustment)
\item Inference criteria (SE choice, $\alpha$, multiple testing plan)
\item Procedures for data issues (missingness, outliers, attention checks)
\item Power / sample-size justification (assumptions explicit)
\end{enumerate}

\end{frame}

%-------------------------------------------------------------------------------%
\begin{frame}{Where do you register a PAP?}
\cite{chen2021preanalysis}

\begin{itemize}
\item The key feature is a \textbf{verifiable time stamp} before analysis.
\item Common registries (examples): EGAP Registry, OSF, AEA RCT Registry.
\item Many projects also make a ``computational PAP'' by writing analysis code in advance and versioning it (e.g., GitHub).
\end{itemize}

\end{frame}

%-------------------------------------------------------------------------------%
\begin{frame}{Worked example: our climate-framing PAP (design)}
\cite{offer2026frame}

\begin{itemize}
\item Setting: survey experiment on climate policy attitudes
\item Sample: $\approx 2300$ U.S.\ respondents (Cloud Connect)
\item Arms: 5 message frames + pure control; uniform random assignment
\item Pre-test and post-test measured on the same policy-support items
\item Outcome: an index (average) of 4 policy-support questions (scaled 0--3)
\end{itemize}

\end{frame}

%-------------------------------------------------------------------------------%
\begin{frame}{Worked example: our climate-framing PAP (analysis targets)}
\cite{offer2026frame}

\begin{enumerate}
\item Mean outcome by arm (overall and by party ID)
\item ATE for each frame vs.\ control (diff-in-means; plus regression adjustment)
\item ``Best on average'' frame vs.\ control (avoid selective inference via sample splitting)
\item ``Best personalized'' assignment vs.\ control (policy learning; sample splitting)
\end{enumerate}

\end{frame}

%-------------------------------------------------------------------------------%
\begin{frame}{Best-arm selection: why sample splitting?}
\cite{offer2026frame}

\begin{itemize}
\item If you estimate 5 treatment effects and pick the largest, the usual p-value/CI for the ``winner'' is too optimistic.
\item Sample splitting makes the selection step explicit:
\begin{itemize}
\item \textbf{Training fold(s):} choose the best arm (by a pre-specified rule)
\item \textbf{Test fold:} estimate the effect of ``being assigned the chosen arm'' vs.\ control
\item Rotate folds so every observation serves as test data once (cross-fitting)
\end{itemize}
\end{itemize}

\end{frame}

%-------------------------------------------------------------------------------%
\begin{frame}{Deviations: what if your plan changes?}
\cite{chen2021preanalysis}

\begin{itemize}
\item Real studies rarely go perfectly (missingness, measurement problems, coding bugs, unexpected distributions).
\item Good practice:
\begin{itemize}
\item keep the preregistered analysis as the primary report
\item document and justify deviations (what changed, why, when)
\item clearly label additional analyses as exploratory/robustness checks
\end{itemize}
\end{itemize}

\end{frame}

%-------------------------------------------------------------------------------%
\begin{frame}[fragile]{Some alternatives to confidence intervals (via \texttt{ungeviz})}

Show the underlying data. 

\tiny
<<eval = FALSE, echo=TRUE>>=
ggplot(iris, aes(Species, Sepal.Length,fill = Species)) +
    geom_violin(alpha = 0.25, color = NA) +
    geom_point(position = position_jitter(width = 0.3, height = 0), size = 0.5) +
    geom_hpline(aes(colour = Species), stat = "summary", width = 0.6, linewidth = 1.5, fun = 'mean')
@
\begin{figure}
\centering
\resizebox{\textwidth}{0.65\textheight}{
<<fig.width = 5, fig.height =5, echo=FALSE, warning=FALSE, message=FALSE>>=
ggplot(iris, aes(Species, Sepal.Length,fill = Species)) +
    geom_violin(alpha = 0.25, color = NA) +
    geom_point(position = position_jitter(width = 0.3, height = 0), size = 0.5) +
    geom_hpline(aes(colour = Species), stat = "summary", width = 0.6, linewidth = 1.5, fun = 'mean') + 
    theme_bw() +
    ylab('Sepal Length')
@
}
\end{figure}

\end{frame}



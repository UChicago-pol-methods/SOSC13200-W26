\begin{frame}{Data overview}

Too many variables\dots
\tiny
<<echo = FALSE, include = FALSE>>=
dat <- read.csv('../data/banerjee-et-al.csv')
@

\begin{itemize}
\item The raw dataset has \Sexpr{nrow(dat)} observations and \Sexpr{ncol(dat)} variables.
\item It combines treatment assignment, borrowing outcomes, and area-level baseline controls.
\end{itemize}

\scriptsize
Key outcomes here include \texttt{spandana\_1}, \texttt{anymfi\_1}, \texttt{anyloan\_1}, \texttt{everlate\_1}, and \texttt{mfi\_loan\_cycles\_1}.

\end{frame}



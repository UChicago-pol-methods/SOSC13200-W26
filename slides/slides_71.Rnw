%-------------------------------------------------------------------------------%
\begin{frame}[fragile]%{Frametitle}

\scriptsize
<<echo = FALSE, include = FALSE>>=

formula1 <- formula(paste0('spandana_1 ~ treatment', 
                           '+ area_pop_base',
                           '+ area_debt_total_base',
                           '+ area_business_total_base',
                           '+ area_exp_pc_mean_base',
                           '+ area_literate_head_base',
                           '+ area_literate_base'))

fit_ctrl <- lm_robust(formula1, data = dat, clusters = areaid, weights = w1)
@

\begin{itemize}
\item With area controls, the treatment estimate is
\[
\hat{\tau} = \Sexpr{round(coef(fit_ctrl)['treatment'], 3)}
\]
\item Its 95\% confidence interval is
\[
\left[\Sexpr{round(confint(fit_ctrl)['treatment', 1], 3)},\ \Sexpr{round(confint(fit_ctrl)['treatment', 2], 3)}\right]
\]
\item The treatment effect remains positive and substantively similar to the version without controls.
\end{itemize}


\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

